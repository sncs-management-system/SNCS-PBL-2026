{
  "name": "sncs-management-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch --env-file=.env server/index.ts",
    "start": "tsx --env-file=.env server/index.ts",
    "build": "vue-tsc --noEmit && tsc --project api/tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "check:supabase": "node scripts/check-supabase.mjs",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit && tsc --project api/tsconfig.json --noEmit",
    "test": "vitest run src server",
    "test:runtime": "node scripts/check-enrollment-runtime.mjs",
    "check:resources": "node scripts/verify-resources.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "express": "^5.2.1",
    "ipaddr.js": "^2.5.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.0.0",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "5.1.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  },
  "packageManager": "pnpm@11.19.0"
}
