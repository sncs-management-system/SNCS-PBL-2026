# Copy to .env locally. Never prefix server secrets with VITE_.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=localhost
APP_ORIGIN=http://localhost:5173
# Generate a stable random secret, at least 32 characters. Share across API replicas.
IP_HASH_SECRET=
PORT=3001
HOST=127.0.0.1
# Optional: comma-separated trusted reverse-proxy IPs/CIDRs, never unrestricted true.
TRUSTED_PROXIES=
