# Public browser configuration for Vue + Vite. Copy to .env.local.
# Supabase dashboard > Project Settings > API Keys: use the publishable key.
# Never put sb_secret_, service_role, or a database password in VITE_ variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Enrollment server configuration. Copy this section to .env locally.
# Never prefix server secrets with VITE_. Both .env and .env.local are gitignored.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Preferred server key from Supabase Settings → API Keys. Fill one key only.
SUPABASE_SECRET_KEY=
# Legacy alternative when SUPABASE_SECRET_KEY is blank.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Connect → Transaction pooler. Server-only, never VITE_.
DATABASE_URL=
# Optional PEM CA certificate if required by the project's verified TLS connection.
DATABASE_SSL_CA=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=localhost
# Origin has no trailing slash; hostname has no scheme, path, or port.
APP_ORIGIN=http://localhost:5173
# Generate a stable random secret, at least 32 characters. Share across API replicas.
IP_HASH_SECRET=
PORT=3001
HOST=127.0.0.1
# Optional: comma-separated trusted reverse-proxy IPs/CIDRs, never unrestricted true.
TRUSTED_PROXIES=
